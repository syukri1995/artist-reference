# Optional configuration for Artist Reference Manager.
# Copy to .env next to the executable (or project root in dev mode).

# Custom library location (database, images, thumbnails, logs)
# ARTIST_REF_DATA_DIR=C:/Users/You/ArtistRefData

# Verbose logging to data/logs/artist_reference.log
# ARTIST_REF_DEBUG=1

# Override GitHub Releases API URL for update checks
# ARTIST_REF_UPDATE_URL=https://api.github.com/repos/syukri1995/artist-reference/releases/latest

# Bake app version at build time (set by CI; dev builds use version.py default)
# ARTIST_REF_VERSION=1.0.0

# Danbooru import (optional — or use Settings → Danbooru tab in the app)
# DANBOORU_BASE_URL=https://danbooru.donmai.us
# DANBOORU_LOGIN=your_username
# DANBOORU_API_KEY=your_api_key
# DANBOORU_SSL_VERIFY=1
